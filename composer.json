{
    "name": "mgrunder/redis-client-tester",
    "description": "Test PhpRedis and Relay clients with randomized workloads, differential checks, and diagnostic tools",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Mgrunder\\RedisClientTester\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mgrunder\\RedisClientTester\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/tester",
        "bin/coercive",
        "bin/killer",
        "bin/harness",
        "bin/sapi",
        "bin/asan",
        "bin/repros",
        "bin/diff",
        "bin/commands",
        "bin/coverage",
        "bin/subscribe",
        "bin/commandstats"
    ],
    "authors": [
        {
            "name": "michael-grunder",
            "email": "michael.grunder@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-json": "*",
        "ext-redis": "*",
        "php-tui/php-tui": "^0.2.1"
    },
    "suggest": {
        "ext-posix": "Required by killer and sapi process supervision",
        "ext-pcntl": "Required by tester --forks and sapi; also lets harness stop cleanly on SIGINT/SIGTERM in plain-output mode",
        "ext-relay": "Required to fuzz Relay\\Relay or Relay\\Cluster clients"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.3"
    },
    "scripts": {
        "analyse": "phpstan analyse --debug --no-progress",
        "test": "phpunit",
        "check": [
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
