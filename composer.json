{
    "name": "mgrunder/redis-client-tester",
    "description": "Test PhpRedis and Relay clients with randomized workloads, differential checks, and diagnostic tools",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Mgrunder\\RedisClientTester\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mgrunder\\RedisClientTester\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/redis-client-tester",
        "bin/redis-client-tester-coercive",
        "bin/redis-client-tester-killer",
        "bin/redis-client-tester-harness",
        "bin/redis-client-tester-sapi",
        "bin/redis-client-tester-asan",
        "bin/redis-client-tester-repros",
        "bin/redis-client-tester-diff",
        "bin/redis-client-tester-commands",
        "bin/redis-client-tester-coverage",
        "bin/redis-client-tester-subscribe",
        "bin/redis-client-tester-commandstats"
    ],
    "authors": [
        {
            "name": "michael-grunder",
            "email": "michael.grunder@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-json": "*",
        "ext-redis": "*",
        "php-tui/php-tui": "^0.2.1"
    },
    "suggest": {
        "ext-posix": "Required by redis-client-tester-killer and redis-client-tester-sapi process supervision",
        "ext-pcntl": "Required by redis-client-tester --forks and redis-client-tester-sapi; also lets redis-client-tester-harness stop cleanly on SIGINT/SIGTERM in plain-output mode",
        "ext-relay": "Required to fuzz Relay\\Relay or Relay\\Cluster clients"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.3"
    },
    "scripts": {
        "analyse": "phpstan analyse --debug --no-progress",
        "test": "phpunit",
        "check": [
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
